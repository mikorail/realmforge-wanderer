{
	"name": "realmforge-wanderer",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "./scripts/run-with-nvm.sh vite",
		"build": "npm run wasm && ./scripts/run-with-nvm.sh vite build",
		"preview": "./scripts/run-with-nvm.sh vite preview",
		"wasm": "GOOS=js GOARCH=wasm go build -ldflags=\"-s -w\" -o public/wasm/qud.wasm ./cmd/wasm && cp \"$(go env GOROOT)/misc/wasm/wasm_exec.js\" public/wasm/",
		"fuzz": "go run ./cmd/fuzz"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"svelte": "^5.57.2",
		"typescript": "^6.0.3",
		"vite": "^8.3.4"
	},
	"dependencies": {
		"@fontsource/share-tech-mono": "^5.3.0",
		"fflate": "^0.8.3"
	}
}
